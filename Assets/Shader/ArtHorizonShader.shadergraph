    },
    "m_SourceType": 1,
    "m_FunctionName": "Angles",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Yaw = atan2(Fwd.x, Fwd.z);\nPitch = atan2(Fwd.y, length(Fwd.xz));\nRoll = atan2(-Right.y, Up.y);"
}

